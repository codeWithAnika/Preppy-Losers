# Frontend (Next.js — copy to .env.local for dev, .env.production for prod)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Sign-In uses Supabase Auth (NOT NextAuth).
# Configure in Supabase Dashboard → Authentication → Providers → Google:
#   - Enable Google provider
#   - Add Google Cloud OAuth Client ID + Secret in Supabase (not in this file)
# Supabase Dashboard → Authentication → URL Configuration:
#   - Site URL: http://localhost:3000 (dev) or https://preppylosers.com (prod)
#   - Redirect URLs (add both):
#       http://localhost:3000/auth/callback**
#       https://preppylosers.com/auth/callback**
# Google Cloud Console → Authorized redirect URI (Supabase handles this):
#   https://<project-ref>.supabase.co/auth/v1/callback
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_SITE_URL=https://preppylosers.com

# Analytics (optional — GA4 measurement ID, format G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Error tracking (optional — Sentry DSN, safe to expose client-side)
NEXT_PUBLIC_SENTRY_DSN=

# Server-only (never expose to browser or commit real values)
SUPABASE_SERVICE_ROLE_KEY=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1

# Production security
FORCE_HTTPS=true
ALLOWED_ORIGINS=https://preppylosers.com,https://www.preppylosers.com

# TLS certificate paths (custom Node/nginx server only — not needed on Vercel)
# SSL_CERT_PATH=/etc/letsencrypt/live/preppylosers.com/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/preppylosers.com/privkey.pem
# SSL_CA_PATH=/etc/letsencrypt/live/preppylosers.com/chain.pem

# Logging
LOG_LEVEL=info

# Resend transactional email (server-only — never use NEXT_PUBLIC_ prefix)
# RESEND_API_KEY: from https://resend.com/api-keys
# RESEND_FROM_EMAIL: verified sender in Resend (must match a sender you verified)
RESEND_API_KEY=
RESEND_FROM_EMAIL=loserspreppy@gmail.com
# Admin inbox for new-order alerts (defaults to loserspreppy@gmail.com)
RESEND_ADMIN_EMAIL=loserspreppy@gmail.com

# Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets)
# Must be the SAME key pair and mode (test or live) as NEXT_PUBLIC_RAZORPAY_KEY_ID
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# ALLOWED_ORIGINS=https://preppylosers.com,https://www.preppylosers.com

# Note: RAZORPAY_KEY_SECRET in .env.local is NOT used by Edge Functions.
# Set secrets via: npx supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=...

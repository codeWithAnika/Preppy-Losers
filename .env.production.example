# Production environment template for preppylosers.com
# Copy to .env.production on your server or configure in Vercel/Cloudflare dashboard.
# NEVER commit this file with real secrets.

NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://preppylosers.com
FORCE_HTTPS=true
ALLOWED_ORIGINS=https://preppylosers.com,https://www.preppylosers.com

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1

LOG_LEVEL=info

# Resend transactional email (server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=loserspreppy@gmail.com
RESEND_ADMIN_EMAIL=loserspreppy@gmail.com

# Custom TLS server only:
# SSL_CERT_PATH=
# SSL_KEY_PATH=
# SSL_CA_PATH=
